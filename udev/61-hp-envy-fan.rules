# hp_envy_fan: let wheel members change the fan curve and HP's thermal mode without root
SUBSYSTEM=="hwmon", ATTR{name}=="hp_envy_fan", RUN+="/bin/chgrp wheel /sys%p/curve /sys%p/curve_enable /sys%p/curve_smooth", RUN+="/bin/chmod g+w /sys%p/curve /sys%p/curve_enable /sys%p/curve_smooth"
SUBSYSTEM=="platform-profile", ATTR{name}=="hp-envy-fan", RUN+="/bin/chgrp wheel /sys%p/profile", RUN+="/bin/chmod g+w /sys%p/profile"
